def glaette_punkte(punkte):
    if len(punkte) < GLAETTUNG_MIN:
        return punkte
    xs = np.array([p[0] for p in punkte], dtype=float)
    ys = np.array([p[1] for p in punkte], dtype=float)
    xs_g = uniform_filter1d(xs, size=GLAETTUNG, mode="nearest")
    ys_g = uniform_filter1d(ys, size=GLAETTUNG, mode="nearest")
    xs_g[0], ys_g[0] = xs[0], ys[0]
    xs_g[-1], ys_g[-1] = xs[-1], ys[-1]
    return [(int(x), int(y)) for x, y in zip(xs_g, ys_g)]

def winkel_zwischen(cx, cy, mx, my):
    return math.degrees(math.atan2(my - cy, mx - cx))

def rotiere_punkt(px, py, cx, cy, grad):
    rad = math.radians(grad)
    dx, dy = px - cx, py - cy
    return (cx + dx * math.cos(rad) - dy * math.sin(rad),
            cy + dx * math.sin(rad) + dy * math.cos(rad))

def obb_punkte(cx, cy, breite, hoehe, winkel_deg):
    """Gibt die 4 Ecken eines rotierten Rechtecks zurück."""
    hw, hh = breite / 2, hoehe / 2
    ecken = [(-hw, -hh), (hw, -hh), (hw, hh), (-hw, hh)]
    return [rotiere_punkt(cx + ex, cy + ey, cx, cy, winkel_deg)
            for ex, ey in ecken]

def punkt_in_obb(px, py, cx, cy, breite, hoehe, winkel_deg):
    """Prüft ob ein Punkt in einem rotierten Rechteck liegt."""
    rad = math.radians(-winkel_deg)
    dx, dy = px - cx, py - cy
    lx =  dx * math.cos(rad) - dy * math.sin(rad)
    ly =  dx * math.sin(rad) + dy * math.cos(rad)
    return abs(lx) <= breite / 2 and abs(ly) <= hoehe / 2

def rect_kollidiert_obb(rect, cx, cy, breite, hoehe, winkel_deg):
    """Prüft ob ein pygame.Rect ein rotiertes Rechteck schneidet (Punkt-Test)."""
    test_punkte = [
        rect.topleft, rect.topright, rect.bottomleft, rect.bottomright,
        rect.center, rect.midtop, rect.midbottom, rect.midleft, rect.midright,
    ]
    return any(punkt_in_obb(px, py, cx, cy, breite, hoehe, winkel_deg)
               for px, py in test_punkte)


