class Spiel:
    def __init__(self):
        pygame.init()
        self.fenster = pygame.display.set_mode((FENSTER_BREITE, FENSTER_HOEHE))
        pygame.display.set_caption("🏁  Rennspiel")
        self.uhr     = pygame.time.Clock()

        # Schriften
        self.s_klein  = pygame.font.SysFont("segoeui", 18)
        self.s_mittel = pygame.font.SysFont("segoeui", 22)
        self.s_gross  = pygame.font.SysFont("segoeui", 26, bold=True)
        self.s_sym    = pygame.font.SysFont("segoeui", 16)  # Symbols/Icons

        print("Erzeuge Grastextur …")
        self.gras_surf = erstelle_gras_textur(FENSTER_BREITE, FENSTER_HOEHE - TOOLBAR_H)
        self.strecke   = Strecke(self.gras_surf)
        self.modus     = Modus.ZEICHNEN
        self.zeichnet  = False
        self.gezogenes_auto = None
        self.autos     = pygame.sprite.Group()

        # Aktives Edit-Objekt (Start/Ziel oder Checkpoint)
        self._edit_obj: RotierbareLinie | None = None

        self._init_autos()
        self._init_ui()
        self._lade_strecke()
        self._update_knopf_status()

        # Feedback-Text
        self._feedback     = ""
        self._feedback_t   = 0

    # ── Init ──────────────────────────────────────────────────
    def _init_autos(self):
        self.auto1 = Auto(120, 100, C_ROT,
                          {"oben": pygame.K_w, "unten": pygame.K_s,
                           "links": pygame.K_a, "rechts": pygame.K_d}, "Rot")
        self.auto2 = Auto(180, 100, C_BLAU,
                          {"oben": pygame.K_UP, "unten": pygame.K_DOWN,
                           "links": pygame.K_LEFT, "rechts": pygame.K_RIGHT}, "Blau")
        self.autos.add(self.auto1, self.auto2)

    def _init_ui(self):
        # Toolbar-Y-Mitte
        ty = FENSTER_HOEHE - TOOLBAR_H + TOOLBAR_H // 2 - 14
        bh = 32

        self.knoepfe = {
            "zeichnen":   Knopf(pygame.Rect( 12, ty, 110, bh), "✏  Strecke"),
            "startziel":  Knopf(pygame.Rect(130, ty, 130, bh), "⬛ Start/Ziel",
                                C_PANEL, C_PANEL_RAND, C_ORANGE),
            "checkpoint": Knopf(pygame.Rect(268, ty, 140, bh), "◈  Checkpoints",
                                C_PANEL, C_PANEL_RAND, C_LILA),
            "platzieren": Knopf(pygame.Rect(416, ty, 110, bh), "🚗  Autos",
                                C_PANEL, C_PANEL_RAND, C_CYAN),
            "fahren":     Knopf(pygame.Rect(534, ty, 120, bh), "▶  Rennen",
                                C_PANEL, C_PANEL_RAND, C_GRUEN),
            "reset":      Knopf(pygame.Rect(1220, ty, 120, bh), "🗑  Reset",
                                C_PANEL, C_PANEL_RAND, C_ROT),
            "speichern":  Knopf(pygame.Rect(1348, ty, 130, bh), "💾  Speichern",
                                C_PANEL, C_PANEL_RAND, C_BLAU),
        }

        # Dicke-Regler (nur im Zeichenmodus sichtbar)
        self.dicke_regler = Regler(680, FENSTER_HOEHE - TOOLBAR_H + 14, "Dicke")
        self.dicke_regler.wert = 20

    def _update_knopf_status(self):
        self.knoepfe["zeichnen"].aktiv   = (self.modus == Modus.ZEICHNEN)
        self.knoepfe["startziel"].aktiv  = (self.modus == Modus.START_ZIEL)
        self.knoepfe["checkpoint"].aktiv = (self.modus == Modus.CHECKPOINT)
        self.knoepfe["platzieren"].aktiv = (self.modus == Modus.PLATZIEREN)
        self.knoepfe["fahren"].aktiv     = (self.modus == Modus.FAHREN)

    def _wechsel_modus(self, m):
        self._edit_obj = None
        self.modus = m
        self._update_knopf_status()

    def _set_feedback(self, text, dauer=120):
        self._feedback   = text
        self._feedback_t = dauer

    # ── Speichern / Laden ─────────────────────────────────────
    def _speichere_strecke(self):
        daten = {
            "linien":      self.strecke.linien,
            "dicke":       self.dicke_regler.wert,
            "start_ziel":  self.strecke.start_ziel.als_dict()
                           if self.strecke.start_ziel else None,
            "checkpoints": [cp.als_dict() for cp in self.strecke.checkpoints],
        }
        SPEICHERDATEI.write_text(json.dumps(daten), encoding="utf-8")
        self._set_feedback("✓  Strecke gespeichert")

    def _lade_strecke(self):
        if not SPEICHERDATEI.exists():
            return
        daten = json.loads(SPEICHERDATEI.read_text(encoding="utf-8"))
        self.strecke.linien = [[tuple(p) for p in l]
                               for l in daten.get("linien", [])]
        self.dicke_regler.wert = daten.get("dicke", 20)

        sz = daten.get("start_ziel")
        if sz:
            self.strecke.start_ziel = StartZiel.von_dict(sz)

        for d in daten.get("checkpoints", []):
            cp = Checkpoint.von_dict(d)
            self.strecke.checkpoints.append(cp)

        self.strecke.rendere(self.dicke_regler.wert, self.s_sym)

    # ── Events ───────────────────────────────────────────────
    def events(self):
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT or (
                    ev.type == pygame.KEYDOWN and ev.key == pygame.K_ESCAPE):
                pygame.quit(); sys.exit()

            # Scroll → Drehen des selektierten Objekts
            if ev.type == pygame.MOUSEWHEEL and self._edit_obj:
                self._edit_obj.winkel = (self._edit_obj.winkel + ev.y * 5) % 360
                self.strecke.rendere(self.dicke_regler.wert, self.s_sym)

            elif ev.type == pygame.MOUSEBUTTONDOWN:
                if ev.button == 1:
                    self._mouse_down(ev)
                elif ev.button == 3:
                    self._rechtsklick(ev)

            elif ev.type == pygame.MOUSEMOTION:
                self._mouse_move(ev)

            elif ev.type == pygame.MOUSEBUTTONUP and ev.button == 1:
                self._mouse_up(ev)

    def _mouse_up(self, ev):
        self.zeichnet = False
        if self._edit_obj:
            self._edit_obj.stop()
            self.strecke.rendere(self.dicke_regler.wert, self.s_sym)
        if self.gezogenes_auto:
            self.gezogenes_auto.wird_gezogen = False
            _, ok = self.strecke.auf_strecke(self.gezogenes_auto.rect)
            self.gezogenes_auto.auf_strecke_platziert = ok
            self.gezogenes_auto.pos = pygame.Vector2(self.gezogenes_auto.rect.center)
            self.gezogenes_auto = None

    def _rechtsklick(self, ev):
        if self.modus == Modus.CHECKPOINT:
            mx, my = ev.pos
            for i, cp in enumerate(self.strecke.checkpoints):
                if cp.drag_hit(mx, my):
                    self.strecke.checkpoints.pop(i)
                    for j, c in enumerate(self.strecke.checkpoints):
                        c.index = j
                    if self._edit_obj is cp:
                        self._edit_obj = None
                    self.strecke.rendere(self.dicke_regler.wert, self.s_sym)
                    self._set_feedback(f"Checkpoint entfernt")
                    break

    def _mouse_down(self, ev):
        # ── Knöpfe ──
        for name, knopf in self.knoepfe.items():
            if knopf.wurde_geklickt(ev):
                self._handle_knopf(name, ev)
                return

        # Dicke-Regler
        if self.modus == Modus.ZEICHNEN:
            if self.dicke_regler.handle_click(ev, DICKE_MIN, DICKE_MAX, DICKE_SCHRITT):
                self.strecke.rendere(self.dicke_regler.wert, self.s_sym)
                return

        if ev.pos[1] >= FENSTER_HOEHE - TOOLBAR_H:
            return

        mx, my = ev.pos

        # ── Modi ──
        if self.modus == Modus.ZEICHNEN:
            self.zeichnet = True
            self.strecke.linien.append([ev.pos])

        elif self.modus == Modus.START_ZIEL:
            if self.strecke.start_ziel:
                sz = self.strecke.start_ziel
                # Handle-Check zuerst
                if sz.handle_hit(mx, my):
                    sz.start_drehen(mx, my)
                    self._edit_obj = sz
                elif sz.drag_hit(mx, my):
                    sz.start_ziehen(mx, my)
                    self._edit_obj = sz
                else:
                    # Neues Start/Ziel
                    self.strecke.start_ziel = StartZiel(mx, my)
                    self._edit_obj = self.strecke.start_ziel
                    self.strecke.rendere(self.dicke_regler.wert, self.s_sym)
            else:
                self.strecke.start_ziel = StartZiel(mx, my)
                self._edit_obj = self.strecke.start_ziel
                self.strecke.rendere(self.dicke_regler.wert, self.s_sym)

        elif self.modus == Modus.CHECKPOINT:
            # Zuerst prüfen ob ein bestehender CP angeklickt wurde
            getroffen = None
            for cp in self.strecke.checkpoints:
                if cp.handle_hit(mx, my):
                    cp.start_drehen(mx, my)
                    self._edit_obj = cp
                    getroffen = cp
                    break
                elif cp.drag_hit(mx, my):
                    cp.start_ziehen(mx, my)
                    self._edit_obj = cp
                    getroffen = cp
                    break
            if not getroffen:
                # Neuen Checkpoint erstellen
                cp = Checkpoint(mx, my, len(self.strecke.checkpoints))
                self.strecke.checkpoints.append(cp)
                self._edit_obj = cp
                self.strecke.rendere(self.dicke_regler.wert, self.s_sym)

        elif self.modus == Modus.PLATZIEREN:
            for auto in self.autos:
                if auto.rect.collidepoint(ev.pos):
                    auto.wird_gezogen = True
                    auto.offset = (auto.rect.x - mx, auto.rect.y - my)
                    self.gezogenes_auto = auto
                    break

    def _handle_knopf(self, name, ev):
        if name == "zeichnen":   self._wechsel_modus(Modus.ZEICHNEN)
        elif name == "startziel":  self._wechsel_modus(Modus.START_ZIEL)
        elif name == "checkpoint": self._wechsel_modus(Modus.CHECKPOINT)
        elif name == "platzieren": self._wechsel_modus(Modus.PLATZIEREN)
        elif name == "fahren":
            bereit = (self.auto1.auf_strecke_platziert
                      and self.auto2.auf_strecke_platziert
                      and self.strecke.start_ziel)
            if bereit:
                self._wechsel_modus(Modus.FAHREN)
            else:
                self._set_feedback("⚠  Autos auf Strecke platzieren + Start/Ziel setzen!")
        elif name == "speichern":  self._speichere_strecke()
        elif name == "reset":
            self.strecke.leere()
            self.strecke.rendere(self.dicke_regler.wert, self.s_sym)
            self._edit_obj = None
            self._set_feedback("Strecke zurückgesetzt")

    def _mouse_move(self, ev):
        mx, my = ev.pos
        if self.modus == Modus.ZEICHNEN and self.zeichnet and my < FENSTER_HOEHE - TOOLBAR_H:
            self.strecke.linien[-1].append(ev.pos)
            self.strecke.rendere(self.dicke_regler.wert, self.s_sym)

        elif self._edit_obj and (self._edit_obj.wird_gedreht or self._edit_obj.wird_gezogen):
            self._edit_obj.update_maus(mx, my)
            self.strecke.rendere(self.dicke_regler.wert, self.s_sym)

        elif self.gezogenes_auto:
            self.gezogenes_auto.rect.x = mx + self.gezogenes_auto.offset[0]
            self.gezogenes_auto.rect.y = my + self.gezogenes_auto.offset[1]

    # ── Zeichnen ─────────────────────────────────────────────
    def _zeichne_spielfeld(self):
        self.fenster.blit(self.strecke.surface, (0, 0))

        # Checkpoints über der Strecke zeichnen (nicht eingebacken)
        edit_modi = self.modus in (Modus.CHECKPOINT, Modus.START_ZIEL,
                                   Modus.PLATZIEREN, Modus.FAHREN)
        for cp in self.strecke.checkpoints:
            sel = (cp is self._edit_obj)
            cp.zeichne(self.fenster, self.s_sym, selektiert=sel,
                       edit_modus=(self.modus == Modus.CHECKPOINT))

        # Start/Ziel separat zeichnen (auch hier, für Drehgriff)
        if self.strecke.start_ziel:
            sz  = self.strecke.start_ziel
            sel = (sz is self._edit_obj)
            sz.zeichne(self.fenster, self.s_sym, selektiert=sel,
                       edit_modus=(self.modus == Modus.START_ZIEL))

        # Autos
        for auto in self.autos:
            ox, oy = auto.get_draw_offset()
            self.fenster.blit(auto.image, (auto.rect.x + ox, auto.rect.y + oy))

        # Platzierungs-Rahmen
        if self.modus == Modus.PLATZIEREN:
            for a in self.autos:
                farbe = C_GRUEN if a.auf_strecke_platziert else C_ROT
                pygame.draw.rect(self.fenster, farbe, a.rect.inflate(6, 6), 2, border_radius=4)

        # CP-Vorschau
        if self.modus == Modus.CHECKPOINT:
            mx, my = pygame.mouse.get_pos()
            if my < FENSTER_HOEHE - TOOLBAR_H:
                # Prüfen ob Hover über bestehendem CP
                hover_cp = any(cp.drag_hit(mx, my) or cp.handle_hit(mx, my)
                               for cp in self.strecke.checkpoints)
                if not hover_cp:
                    vor = pygame.Surface((CP_BREITE, CP_HOEHE), pygame.SRCALPHA)
                    vor.fill((*C_LILA, 100))
                    self.fenster.blit(vor, (mx - CP_BREITE//2, my - CP_HOEHE//2))

        # Offroad-Warn-Labels
        if self.modus == Modus.FAHREN:
            for auto in [self.auto1, self.auto2]:
                _, auf_str = self.strecke.auf_strecke(auto.rect)
                if not auf_str and abs(auto.speed) > 0.3:
                    warn = self.s_klein.render("OFFROAD", True, auto.farbe)
                    bx   = auto.rect.centerx - warn.get_width()//2
                    by   = auto.rect.top - 22
                    if 0 <= bx < FENSTER_BREITE and 0 <= by < FENSTER_HOEHE - TOOLBAR_H:
                        # Hintergrundkasten
                        bg = pygame.Surface((warn.get_width()+8, warn.get_height()+4),
                                            pygame.SRCALPHA)
                        bg.fill((0,0,0,120))
                        self.fenster.blit(bg, (bx-4, by-2))
                        self.fenster.blit(warn, (bx, by))

    def _zeichne_toolbar(self):
        tb_rect = pygame.Rect(0, FENSTER_HOEHE - TOOLBAR_H, FENSTER_BREITE, TOOLBAR_H)
        pygame.draw.rect(self.fenster, C_TOOLBAR, tb_rect)
        # Trennlinie oben
        zeichne_neon_linie(self.fenster, C_PANEL_RAND,
                           (0, FENSTER_HOEHE - TOOLBAR_H),
                           (FENSTER_BREITE, FENSTER_HOEHE - TOOLBAR_H), 1, glow=False)

        # Knöpfe
        for name, knopf in self.knoepfe.items():
            knopf.zeichne(self.fenster, self.s_mittel)

        # Dicke-Regler (nur Zeichenmodus)
        if self.modus == Modus.ZEICHNEN:
            self.dicke_regler.zeichne(self.fenster, self.s_klein)

        # Status-Info in der Mitte
        info_map = {
            Modus.ZEICHNEN:   "Maus halten → Strecke zeichnen",
            Modus.START_ZIEL: "Klick → setzen  |  Ziehen → verschieben  |  ↻-Knopf / Scroll → drehen",
            Modus.CHECKPOINT: "Klick → setzen  |  Ziehen → verschieben  |  ↻-Knopf / Scroll → drehen  |  Rechtsklick → löschen",
            Modus.PLATZIEREN: "Auto auf Strecke ziehen (grüner Rahmen = OK)",
            Modus.FAHREN:     "ROT: WASD   |   BLAU: Pfeiltasten",
        }
        info = info_map.get(self.modus, "")
        txt  = self.s_klein.render(info, True, C_TEXT_DIM)
        self.fenster.blit(txt, txt.get_rect(
            center=(FENSTER_BREITE // 2, FENSTER_HOEHE - 14)))

    def _zeichne_hud(self):
        """Rundenanzeige oben links."""
        n_cps = len(self.strecke.checkpoints)

        for i, (auto, y_off) in enumerate([(self.auto1, 0), (self.auto2, 1)]):
            px, py = 16, 16 + i * 62
            # Panel
            panel = pygame.Rect(px, py, 200, 52)
            panel_surf = pygame.Surface((panel.w, panel.h), pygame.SRCALPHA)
            panel_surf.fill((*C_PANEL, 200))
            self.fenster.blit(panel_surf, panel.topleft)
            pygame.draw.rect(self.fenster, auto.farbe, panel, 1, border_radius=6)

            # Name + Runden
            name_txt  = self.s_gross.render(auto.name, True, auto.farbe)
            runde_txt = self.s_gross.render(f"Runde {auto.runden}", True, C_TEXT)
            self.fenster.blit(name_txt,  (px + 8, py + 6))
            self.fenster.blit(runde_txt, (px + 8 + name_txt.get_width() + 10, py + 6))

            # Checkpoint-Fortschritt (nur Fahrenmodus)
            if n_cps > 0 and self.modus == Modus.FAHREN:
                ok = len(auto.checkpoints_ok)
                cp_bar_w = 184
                pygame.draw.rect(self.fenster, C_PANEL_RAND,
                                 (px+8, py+34, cp_bar_w, 10), border_radius=4)
                if n_cps > 0:
                    fill = int(cp_bar_w * ok / n_cps)
                    if fill > 0:
                        pygame.draw.rect(self.fenster, auto.farbe,
                                         (px+8, py+34, fill, 10), border_radius=4)
                cp_txt = self.s_klein.render(f"CP {ok}/{n_cps}", True, C_TEXT_DIM)
                self.fenster.blit(cp_txt, (px + cp_bar_w - cp_txt.get_width() + 8, py + 34))

        # Feedback-Text
        if self._feedback_t > 0:
            alpha = min(255, self._feedback_t * 6)
            fb_txt = self.s_mittel.render(self._feedback, True, C_GELB)
            fb_bg  = pygame.Surface((fb_txt.get_width()+20, fb_txt.get_height()+10),
                                    pygame.SRCALPHA)
            fb_bg.fill((0, 0, 0, min(200, alpha)))
            cx = FENSTER_BREITE // 2
            cy = FENSTER_HOEHE - TOOLBAR_H - 40
            self.fenster.blit(fb_bg, (cx - fb_bg.get_width()//2, cy))
            self.fenster.blit(fb_txt, fb_txt.get_rect(center=(cx, cy + fb_bg.get_height()//2)))
            self._feedback_t -= 1

    def zeichne(self):
        self._zeichne_spielfeld()
        self._zeichne_toolbar()
        self._zeichne_hud()
        pygame.display.flip()

    # ── Main Loop ─────────────────────────────────────────────
    def run(self):
        while True:
            self.events()
            if self.modus == Modus.FAHREN:
                self.autos.update(self.strecke)
            self.zeichne()
            self.uhr.tick(FPS)


if __name__ == "__main__":
