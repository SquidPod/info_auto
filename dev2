class Knopf:
    def __init__(self, rect, text, farbe=C_PANEL, hover=C_PANEL_RAND,
                 aktiv_farbe=C_GRUEN, icon=None):
        self.rect        = rect
        self.text        = text
        self.farbe       = farbe
        self.hover_farbe = hover
        self.aktiv_farbe = aktiv_farbe
        self.aktiv       = False
        self._hover_anim = 0.0  # 0..1

    def zeichne(self, surf, schrift):
        maus = pygame.mouse.get_pos()
        hover = self.rect.collidepoint(maus)

        if self.aktiv:
            bg = self.aktiv_farbe
            rand = tuple(min(255, c + 50) for c in self.aktiv_farbe)
        elif hover:
            bg   = self.hover_farbe
            rand = C_TEXT_DIM
        else:
            bg   = self.farbe
            rand = C_PANEL_RAND

        # Schatten
        schatten = self.rect.move(0, 2)
        pygame.draw.rect(surf, (0,0,0,60), schatten, border_radius=7)

        pygame.draw.rect(surf, bg, self.rect, border_radius=7)
        pygame.draw.rect(surf, rand, self.rect, 1, border_radius=7)

        # Glanz-Linie oben
        glanz = pygame.Rect(self.rect.x+2, self.rect.y+1,
                            self.rect.w-4, 2)
        glanz_surf = pygame.Surface((glanz.w, glanz.h), pygame.SRCALPHA)
        glanz_surf.fill((255,255,255,30))
        surf.blit(glanz_surf, glanz.topleft)

        txt_farbe = C_WEISS if (self.aktiv or hover) else C_TEXT
        txt = schrift.render(self.text, True, txt_farbe)
        surf.blit(txt, txt.get_rect(center=self.rect.center))

    def wurde_geklickt(self, ev):
        return (ev.type == pygame.MOUSEBUTTONDOWN
                and ev.button == 1
                and self.rect.collidepoint(ev.pos))


class Regler:
    """Kompakter +/- Regler für Streckendicke."""
    def __init__(self, x, y, label):
        self.label  = label
        self.rect_minus = pygame.Rect(x,      y, 28, 28)
        self.rect_plus  = pygame.Rect(x + 72, y, 28, 28)
        self.rect_wert  = pygame.Rect(x + 30, y, 40, 28)
        self.wert   = 20

    def zeichne(self, surf, schrift):
        for r, t in [(self.rect_minus, "−"), (self.rect_plus, "+")]:
            hover = r.collidepoint(pygame.mouse.get_pos())
            pygame.draw.rect(surf, C_PANEL_RAND if hover else C_PANEL, r, border_radius=5)
            pygame.draw.rect(surf, C_TEXT_DIM, r, 1, border_radius=5)
            txt = schrift.render(t, True, C_TEXT)
            surf.blit(txt, txt.get_rect(center=r.center))

        pygame.draw.rect(surf, (0,0,0,40), self.rect_wert, border_radius=4)
        txt = schrift.render(str(self.wert), True, C_GELB)
        surf.blit(txt, txt.get_rect(center=self.rect_wert.center))

        lbl = schrift.render(self.label, True, C_TEXT_DIM)
        surf.blit(lbl, (self.rect_minus.x,
                        self.rect_minus.y - 16))

    def handle_click(self, ev, min_v, max_v, schritt):
        if ev.type != pygame.MOUSEBUTTONDOWN or ev.button != 1:
            return False
        if self.rect_minus.collidepoint(ev.pos):
            self.wert = max(min_v, self.wert - schritt)
            return True
        if self.rect_plus.collidepoint(ev.pos):
            self.wert = min(max_v, self.wert + schritt)
            return True
        return False


