def erstelle_gras_textur(breite, hoehe):
    surf = pygame.Surface((breite, hoehe))
    surf.fill(C_GRAS_BASIS)
    rng = random.Random(42)
    for _ in range(3500):
        x, y = rng.randint(0, breite-1), rng.randint(0, hoehe-1)
        r = rng.randint(6, 45)
        farbe = C_GRAS_HELL if rng.random() > 0.5 else C_GRAS_DUNKEL
        pygame.draw.circle(surf, farbe, (x, y), r)
    for _ in range(7000):
        x, y = rng.randint(0, breite-1), rng.randint(0, hoehe-1)
        laenge = rng.randint(3, 10)
        w = rng.uniform(-0.45, 0.45)
        g = rng.randint(115, 180)
        farbe = (rng.randint(28, 55), g, rng.randint(28, 55))
        pygame.draw.line(surf, farbe, (x, y),
                         (x + int(math.sin(w)*laenge), y - laenge), 1)
    for _ in range(500):
        x, y = rng.randint(0, breite-1), rng.randint(0, hoehe-1)
        t = rng.random()
        if t < 0.35:
            pygame.draw.circle(surf, (200, 195, 75), (x, y), 2)
        elif t < 0.6:
            pygame.draw.circle(surf, (225, 225, 215), (x, y), 2)
        else:
            pygame.draw.circle(surf, (135, 125, 115), (x, y), rng.randint(1,3))
    return surf


