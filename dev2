# STRECKE
# ═══════════════════════════════════════════════════════════════
class Strecke:
    def __init__(self, gras_surf):
        self.gras_surf   = gras_surf
        self.surface     = pygame.Surface((FENSTER_BREITE, FENSTER_HOEHE - TOOLBAR_H))
        self.linien: list[list] = []
        self.start_ziel: StartZiel | None = None
        self.checkpoints: list[Checkpoint] = []
        self._dicke  = 20
        self._schrift = None
        self._render_intern()

    def leere(self):
        self.linien.clear()
        self.checkpoints.clear()
        self.start_ziel = None
        self._render_intern()

    def _render_intern(self):
        self.surface.blit(self.gras_surf, (0, 0))
        for linie in self.linien:
            if not linie:
                continue
            for p in glaette_punkte(linie):
                pygame.draw.circle(self.surface, C_SCHWARZ, p, self._dicke)
        # Start/Ziel und Checkpoints auf die surface zeichnen
        # (für Pixel-Kollision brauchen wir Checkpoints NICHT auf der surface)
        if self.start_ziel:
            self.start_ziel.zeichne(self.surface)

    def rendere(self, dicke, schrift=None):
        self._dicke   = dicke
        self._schrift = schrift
        self._render_intern()

    def pixel_auf_strecke(self, x, y):
        w, h = self.surface.get_size()
        x = max(0, min(int(x), w - 1))
        y = max(0, min(int(y), h - 1))
        farbe = self.surface.get_at((x, y))[:3]
        return farbe == C_SCHWARZ

    def auf_strecke(self, rect):
        punkte = [
            rect.topleft, rect.topright, rect.bottomleft, rect.bottomright,
            rect.center, rect.midtop, rect.midbottom, rect.midleft, rect.midright,
        ]
        treffer = sum(1 for x, y in punkte if self.pixel_auf_strecke(x, y))
        anteil  = treffer / len(punkte)
        return anteil, anteil >= STRECKEN_SCHWELLE


