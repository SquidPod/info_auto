# AUTO
# ═══════════════════════════════════════════════════════════════
class Auto(pygame.sprite.Sprite):
    def __init__(self, x, y, farbe, steuerung, name):
        super().__init__()
        self.name      = name
        self.farbe     = farbe
        self.steuerung = steuerung

        self.base_image = pygame.Surface((AUTO_BREITE, AUTO_HOEHE), pygame.SRCALPHA)
        # Karosserie
        pygame.draw.rect(self.base_image, farbe, (0, 0, AUTO_BREITE, AUTO_HOEHE), border_radius=5)
        # Fenster
        wf = tuple(min(255, c + 60) for c in farbe)
        pygame.draw.rect(self.base_image, wf, (3, 8, AUTO_BREITE-6, 12), border_radius=3)
        # Frontlichter
        pygame.draw.circle(self.base_image, (255,255,200), (4, 3), 2)
        pygame.draw.circle(self.base_image, (255,255,200), (AUTO_BREITE-4, 3), 2)
        # Rücklichter
        pygame.draw.circle(self.base_image, C_ROT, (4, AUTO_HOEHE-4), 2)
        pygame.draw.circle(self.base_image, C_ROT, (AUTO_BREITE-4, AUTO_HOEHE-4), 2)

        self.image = self.base_image.copy()
        self.rect  = self.image.get_rect(center=(x, y))
        self.pos   = pygame.Vector2(x, y)
        self.angle = 0.0
        self.speed = 0.0

        self.runden              = 0
        self.im_ziel             = False
        self.checkpoints_ok: set[int] = set()

        self.wird_gezogen          = False
        self.offset                = (0, 0)
        self.auf_strecke_platziert = False
        self._offroad_timer        = 0

    def update(self, strecke: Strecke):
        keys = pygame.key.get_pressed()
        _, auf_strecke = strecke.auf_strecke(self.rect)

        # Beschleunigung
        if keys[self.steuerung["oben"]]:
            self.speed += ACCELERATION
        elif keys[self.steuerung["unten"]]:
            self.speed -= BRAKE_POWER
        else:
            reibung = FRICTION if auf_strecke else OFFROAD_FRICTION
            self.speed = (max(0.0, self.speed - reibung) if self.speed > 0
                          else min(0.0, self.speed + reibung))

        v_max = MAX_SPEED if auf_strecke else MAX_OFFROAD_SPEED
        self.speed = max(-v_max/2, min(v_max, self.speed))

        # Lenkung
        if abs(self.speed) > 0.1:
            lenkwinkel = TURN_SPEED * (1.0 - abs(self.speed)/MAX_SPEED * 0.35)
            if self.speed < 0:
                lenkwinkel = -lenkwinkel
            if keys[self.steuerung["links"]]:
                self.angle += lenkwinkel
            if keys[self.steuerung["rechts"]]:
                self.angle -= lenkwinkel

        self.angle %= 360
        self.image  = pygame.transform.rotate(self.base_image, self.angle)

        richtung  = pygame.Vector2(0, -1).rotate(-self.angle)
        self.pos += richtung * self.speed
        self.rect  = self.image.get_rect(center=(int(self.pos.x), int(self.pos.y)))

        # Spielfeldrand
        spielfeld = pygame.Rect(0, 0, FENSTER_BREITE, FENSTER_HOEHE - TOOLBAR_H)
        if not spielfeld.contains(self.rect):
            self.pos  -= richtung * self.speed
            self.rect  = self.image.get_rect(center=(int(self.pos.x), int(self.pos.y)))
            self.speed *= -0.3

        # Offroad-Rüttel
        self._offroad_timer = ((self._offroad_timer + 1) % 6
                               if not auf_strecke and abs(self.speed) > 0.2 else 0)

        # Checkpoints
        for cp in strecke.checkpoints:
            if cp.kollidiert(self.rect):
                self.checkpoints_ok.add(cp.index)

        # Ziel
        if strecke.start_ziel:
            alle_ok = len(self.checkpoints_ok) >= len(strecke.checkpoints)
            if strecke.start_ziel.kollidiert(self.rect):
                if not self.im_ziel and self.speed > 0 and alle_ok:
                    self.runden += 1
                    self.checkpoints_ok.clear()
                    self.im_ziel = True
            else:
                self.im_ziel = False

    def get_draw_offset(self):
        if self._offroad_timer > 0:
            return (random.randint(-1, 1), random.randint(-1, 1))
        return (0, 0)


