# ROTIERBARE LINIE (Checkpoint & Start/Ziel)
# ═══════════════════════════════════════════════════════════════
class RotierbareLinie:
    """Basis für Start/Ziel und Checkpoints — rotierbar per Drag."""

    def __init__(self, cx, cy, breite, hoehe, farbe, rand_farbe, label=""):
        self.cx = float(cx)
        self.cy = float(cy)
        self.breite  = breite
        self.hoehe   = hoehe
        self.winkel  = 0.0          # Grad, 0 = horizontal
        self.farbe   = farbe
        self.rand_farbe = rand_farbe
        self.label   = label
        self.index   = 0
        # Zustand
        self.wird_gedreht  = False
        self.wird_gezogen  = False
        self.drag_offset   = (0.0, 0.0)
        self.dreh_start_maus_winkel  = 0.0
        self.dreh_start_obj_winkel   = 0.0

    # ── Handle-Positionen ──────────────────────────────────────
    def handle_pos(self):
        """Rechtes Ende der Linie = Drehgriff."""
        hx = self.cx + (self.breite / 2 + HANDLE_R + 4)
        hy = self.cy
        return rotiere_punkt(hx, hy, self.cx, self.cy, self.winkel)

    def drag_hit(self, mx, my):
        """True wenn auf dem Körper der Linie geklickt."""
        return punkt_in_obb(mx, my, self.cx, self.cy,
                            self.breite, self.hoehe + 14, self.winkel)

    def handle_hit(self, mx, my):
        hx, hy = self.handle_pos()
        return math.hypot(mx - hx, my - hy) <= HANDLE_R + 3

    # ── Mouse-Events ──────────────────────────────────────────
    def start_drehen(self, mx, my):
        self.wird_gedreht = True
        self.dreh_start_maus_winkel  = winkel_zwischen(self.cx, self.cy, mx, my)
        self.dreh_start_obj_winkel   = self.winkel

    def start_ziehen(self, mx, my):
        self.wird_gezogen = True
        self.drag_offset  = (self.cx - mx, self.cy - my)

    def update_maus(self, mx, my):
        if self.wird_gedreht:
            delta = winkel_zwischen(self.cx, self.cy, mx, my) - self.dreh_start_maus_winkel
            self.winkel = (self.dreh_start_obj_winkel + delta) % 360
        elif self.wird_gezogen:
            self.cx = mx + self.drag_offset[0]
            self.cy = my + self.drag_offset[1]

    def stop(self):
        self.wird_gedreht = False
        self.wird_gezogen = False

    # ── Kollision ──────────────────────────────────────────────
    def kollidiert(self, rect):
        return rect_kollidiert_obb(rect, self.cx, self.cy,
                                   self.breite, self.hoehe, self.winkel)

    # ── Zeichnen ──────────────────────────────────────────────
    def zeichne(self, surf, schrift=None, selektiert=False, edit_modus=False):
        ecken = obb_punkte(self.cx, self.cy, self.breite, self.hoehe, self.winkel)
        pts   = [(int(x), int(y)) for x, y in ecken]

        # Schatten
        schatten_pts = [(x+2, y+2) for x, y in pts]
        pygame.draw.polygon(surf, (0, 0, 0, 80), schatten_pts)

        pygame.draw.polygon(surf, self.farbe, pts)
        if selektiert:
            pygame.draw.polygon(surf, C_WEISS, pts, 2)
        else:
            pygame.draw.polygon(surf, self.rand_farbe, pts, 1)

        # Streifen-Muster (Schachbrett-ähnlich)
        self._zeichne_streifen(surf, ecken)

        # Label / Index
        if schrift and self.label:
            txt = schrift.render(self.label, True, C_WEISS)
            # Rotiert auf der Fläche
            txt_rot = pygame.transform.rotate(txt, -self.winkel)
            surf.blit(txt_rot, txt_rot.get_rect(center=(int(self.cx), int(self.cy))))

        # Drehgriff (nur im Edit-Modus)
        if edit_modus:
            hx, hy = self.handle_pos()
            hx, hy = int(hx), int(hy)
            # Verbindungslinie
            ex = int(self.cx + (self.breite/2) * math.cos(math.radians(self.winkel)))
            ey = int(self.cy + (self.breite/2) * math.sin(math.radians(self.winkel)))
            pygame.draw.line(surf, C_TEXT_DIM, (ex, ey), (hx, hy), 1)
            # Kreis
            col = C_GELB if self.wird_gedreht else C_CYAN
            pygame.draw.circle(surf, col, (hx, hy), HANDLE_R)
            pygame.draw.circle(surf, C_WEISS, (hx, hy), HANDLE_R, 1)
            # Pfeil-Symbol
            if schrift:
                t = schrift.render("↻", True, C_SCHWARZ)
                surf.blit(t, t.get_rect(center=(hx, hy)))

    def _zeichne_streifen(self, surf, ecken):
        pass  # Wird von Unterklassen überschrieben

    def als_dict(self):
        return {"cx": self.cx, "cy": self.cy, "winkel": self.winkel}

    @classmethod
    def von_dict(cls, d, *args, **kwargs):
        obj = cls(d["cx"], d["cy"], *args, **kwargs)
        obj.winkel = d.get("winkel", 0.0)
        return obj


class StartZiel(RotierbareLinie):
    def __init__(self, cx, cy):
        super().__init__(cx, cy, SZ_BREITE, SZ_HOEHE, C_ORANGE, C_ORANGE_HELL, "")

    def _zeichne_streifen(self, surf, ecken):
        # Schwarz-weiße Schachbrettstreifen
        n = 8
        for i in range(n):
            t0 = i / n
            t1 = (i + 1) / n
            # Interpoliere entlang der Breite
            def interp(t):
                p0 = (ecken[0][0] + t*(ecken[1][0]-ecken[0][0]),
                      ecken[0][1] + t*(ecken[1][1]-ecken[0][1]))
                p1 = (ecken[3][0] + t*(ecken[2][0]-ecken[3][0]),
                      ecken[3][1] + t*(ecken[2][1]-ecken[3][1]))
                return p0, p1
            a0, b0 = interp(t0)
            a1, b1 = interp(t1)
            farbe = C_SCHWARZ if i % 2 == 0 else C_WEISS
            pts = [(int(a0[0]), int(a0[1])), (int(a1[0]), int(a1[1])),
                   (int(b1[0]), int(b1[1])), (int(b0[0]), int(b0[1]))]
            pygame.draw.polygon(surf, farbe, pts)

    def als_dict(self):
        d = super().als_dict()
        return d

    @classmethod
    def von_dict(cls, d):
        obj = cls(d["cx"], d["cy"])
        obj.winkel = d.get("winkel", 0.0)
        return obj


class Checkpoint(RotierbareLinie):
    def __init__(self, cx, cy, index=0):
        super().__init__(cx, cy, CP_BREITE, CP_HOEHE, C_LILA, C_LILA_HELL, "")
        self.index = index

    @property
    def label(self):
        return str(self.index + 1)

    @label.setter
    def label(self, v):
        pass  # Ignorieren, label ist dynamisch

    def _zeichne_streifen(self, surf, ecken):
        # Diagonale Streifen in Lila/Weiß
        n = 6
        for i in range(n):
            t0, t1 = i / n, (i + 1) / n
            def interp(t):
                p0 = (ecken[0][0] + t*(ecken[1][0]-ecken[0][0]),
                      ecken[0][1] + t*(ecken[1][1]-ecken[0][1]))
                p1 = (ecken[3][0] + t*(ecken[2][0]-ecken[3][0]),
                      ecken[3][1] + t*(ecken[2][1]-ecken[3][1]))
                return p0, p1
            a0, b0 = interp(t0)
            a1, b1 = interp(t1)
            farbe = C_LILA_HELL if i % 2 == 0 else (100, 40, 145)
            pts = [(int(a0[0]),int(a0[1])), (int(a1[0]),int(a1[1])),
                   (int(b1[0]),int(b1[1])), (int(b0[0]),int(b0[1]))]
            pygame.draw.polygon(surf, farbe, pts)

    def als_dict(self):
        d = super().als_dict()
        d["index"] = self.index
        return d

    @classmethod
    def von_dict(cls, d):
        obj = cls(d["cx"], d["cy"], d.get("index", 0))
        obj.winkel = d.get("winkel", 0.0)
        return obj


